# APP_GEMINI_KEY: Opsiyonel AI ozellikleri icin sunucu ortami degiskeni.
APP_GEMINI_KEY=""

# APP_URL: Uygulamanin yayinlandigi tam URL.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Oturum imzalama ve guvenlik anahtari (uretimde guclu rastgele deger kullanin).
SESSION_SECRET="change-this-to-a-long-random-secret-in-production"

# DB_PATH: SQLite veritabani dosya yolu.
DB_PATH="./data/orbit.db"

# UPLOAD_DIR: Kullanici dosya eklerinin saklandigi dizin.
UPLOAD_DIR="./uploads"

# WebRTC STUN/TURN Yapilandirmasi (Kisiti NAT aglarinda ses/goruntu icin TURN onerilir)
STUN_URL="stun:stun.l.google.com:19302"
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Opsiyonel GIF Arama Entegrasyonu (Tenor API v2)
TENOR_API_KEY=""

# Opsiyonel Web Push VAPID Anahtarlari
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Google OAuth (Google ile Giris Yap)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ORBIT Nitro Ucretli Abonelik (Stripe Checkout & Webhook)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_NITRO_PRICE_ID=""
STRIPE_NITRO_YEARLY_PRICE_ID=""

